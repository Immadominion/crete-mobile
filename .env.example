# API Configuration
API_BASE_URL=https://api.crete.dev
WEBSOCKET_URL=wss://ws.crete.dev

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# App Configuration
APP_NAME=Crete
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# Feature Flags
ENABLE_DISCORD_IMPORT=true
ENABLE_GUEST_MODE=true
ENABLE_ANALYTICS=false

# External Services
BLINKS_API_URL=https://blinks.crete.dev
NOTIFICATION_SERVICE_URL=https://notifications.crete.dev

# Debug Settings
ENABLE_DEBUG_LOGS=true
ENABLE_NETWORK_LOGGING=true

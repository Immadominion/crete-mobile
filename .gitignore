/android/app/release

# Security & Secrets - CRITICAL FOR PRODUCTION
# Environment files (keep only .env.example)
.env.dev
.env.staging
.env.prod

# Firebase configuration files (contain API keys)
**/GoogleService-Info.plist
**/google-services.json

# iOS specific sensitive files
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# Android specific sensitive files
android/app/google-services.json

# Certificate and key files
*.p12
*.p8
*.pem
*.key
*.crt
*.cer
*.mobileprovision

# Local configuration files
local.properties
*.keystore
key.properties
